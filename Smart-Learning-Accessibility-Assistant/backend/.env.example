# Required: Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Configurable Gemini model name
GEMINI_MODEL=gemini-2.5-flash

# Required for YouTube Learning Video Recommendations (YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Required in production: Strong random secret for signing JWT tokens (min 32 chars)
# Example to generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL:
# Local development uses SQLite by default:
DATABASE_URL=sqlite:///./smart_learning.db
# Production (Render PostgreSQL) uses PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/smart_learning

# Optional: Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: Regex for preview deployment origins (e.g. Vercel previews)
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional: Upload and text safety limits
MAX_UPLOAD_SIZE_MB=12
MAX_SPEECH_CHARS=25000
